# Optional: Auni runs with none of this. Copy it to ~/.auni/.env to change a default; it mirrors
# src/env.ts and each app's about.ts (src/apps/<id>/), which say more about each. What's
# already set in the environment wins.
# Auni keeps what lives on this machine (this file, its database, keys, secrets) in ~/.auni, or
# in AUNI_HOME when the environment sets one, so that one is never set here.
# Core's API. Unset, it listens on this machine only (127.0.0.1:4000), which the web app reaches.
# PORT=4000
# HOST=
# The web app Auni runs: unset, on this machine only (127.0.0.1:3000); the Docker image
# sets 0.0.0.0.
# WEB_PORT=3000
# WEB_HOST=
# Where the browser opens the web app; pairing links point at it. Unset, http://localhost:<WEB_PORT>.
# WEB_ORIGIN=
# Always on: the owner's Tailscale login, which `auni up --always-on` records with WEB_ORIGIN, this
# machine's https address on the tailnet. Set, Auni is reached only through `tailscale serve`, and
# a request from this login through it is the owner's, with no pairing. Unset, this computer only.
# TAILSCALE_OWNER=
# Your own Postgres. Unset, Auni runs one of its own under AUNI_HOME.
# DATABASE_URL=

# The wallet app: unset, local-key (keys on this machine: in the OS keychain for ~/.auni,
# else in the data folder). WALLET=privy uses server wallets in your own Privy app, owned by
# PRIVY_AUTHORIZATION_KEY.
# WALLET=
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# PRIVY_AUTHORIZATION_KEY=
# The chains: unset, each network's public RPCs (packages/shared/src/networks.ts), which find
# deposits as well. RPC_URL_<CHAIN> (RPC_URL_MONAD, RPC_URL_BASE, RPC_URL_SOLANA, ...) is an RPC of
# your own, used alone for that chain; ALCHEMY_API_KEY is Alchemy for every chain without one.
# RPC_URL_MONAD=
# ALCHEMY_API_KEY=

# The brain: your own Claude Code (`claude auth login`) or Codex (`codex login --device-auth`) on
# this machine, with your own login. BRAIN names the brain app to use first (claude-code,
# codex); unset, Claude Code when it's logged in, else Codex. When one reaches its usage limit, another that's
# logged in answers until it resets. AUNI_ANTHROPIC_API_KEY bills an Anthropic API key instead of your
# Claude login. Codex adds your own ~/.codex/AGENTS.md to every turn; to keep it out, run Auni with
# CODEX_HOME set to a Codex home of its own, logged in there.
# BRAIN=
# AUNI_ANTHROPIC_API_KEY=
# Signs each turn's token and seals cards; at least 32 characters. Unset, Auni makes one once and
# keeps it under AUNI_HOME.
# TURN_TOKEN_SECRET=
# Set to anything, core also logs what helps whoever works on Auni, such as each turn's timing.
# AUNI_DEBUG=

# The keys from here down can also be pasted into their app under Apps, in the web app, where one
# works with no restart; Auni then writes it to this file itself.

# Elfa Auto, a watch source for news, posts and more (prices need no key: the prices app).
# Its fires come over Elfa's stream, which Auni keeps open, so no public address is needed.
# ELFA_AUTO_API_KEY=

# Telegram: a bot of your own from @BotFather, to talk to Auni and allow its moves there. Then
# `auni pair --channel telegram` prints the code that pairs your account with it.
# TELEGRAM_BOT_TOKEN=

# Relay, which buys a chain's coin for network fees from another chain when the wallet is short.
# Its docs ask each call to carry a key; unset, Auni calls without one, as Relay answers today.
# RELAY_API_KEY=

# Venues: each one's tools say they're unavailable without its credentials.
# JUPITER_API_KEY=
# POLYMARKET_BUILDER_API_KEY=
# POLYMARKET_BUILDER_SECRET=
# POLYMARKET_BUILDER_PASSPHRASE=
